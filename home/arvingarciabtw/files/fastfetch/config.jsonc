{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "source": "~/.config/fastfetch/nixos_logo.txt",
    "color": {
      "1": "#AB9DF2",
      "2": "#AB9DF2",
      "3": "",
      "4": "",
      "5": "",
      "6": "",
      "7": "",
      "8": "",
      "9": "",
    },
    "width": null,
    "height": null,
    "padding": {
      "top": 0,
      "left": 0,
      "right": 8,
    },
    "printRemaining": true,
    "preserveAspectRatio": false,
    "recache": false,
    "position": "left",
    "chafa": {
      "fgOnly": false,
      "symbols": "block+border+space-wide-inverted",
    },
  },
  "display": {
    "stat": false,
    "pipe": false,
    "showErrors": false,
    "disableLinewrap": true,
    "hideCursor": false,
    "separator": ": ",
    "color": {
      "keys": "#FCFCFA",
      "title": "",
      "output": "#727072",
      "separator": "",
    },
    "brightColor": true,
    "duration": {
      "abbreviation": false,
      "spaceBeforeUnit": "default",
    },
    "size": {
      "maxPrefix": "YB",
      "binaryPrefix": "iec",
      "ndigits": 2,
      "spaceBeforeUnit": "default",
    },
    "temp": {
      "unit": "D",
      "ndigits": 1,
      "color": {
        "green": "#A9DC76",
        "yellow": "#FFD866",
        "red": "#FF6188",
      },
      "spaceBeforeUnit": "default",
    },
    "percent": {
      "type": ["num", "num-color"],
      "ndigits": 0,
      "color": {
        "green": "#A9DC76",
        "yellow": "#FFD866",
        "red": "#FF6188",
      },
      "spaceBeforeUnit": "default",
      "width": 0,
    },
    "bar": {
      "char": {
        "elapsed": "■",
        "total": "-",
      },
      "border": {
        "left": "[ ",
        "right": " ]",
        "leftElapsed": "",
        "rightElapsed": "",
      },
      "color": {
        "elapsed": "auto",
        "total": "#727072",
        "border": "#727072",
      },
      "width": 10,
    },
    "fraction": {
      "ndigits": 2,
    },
    "noBuffer": false,
    "key": {
      "width": 0,
      "type": "string",
      "paddingLeft": 0,
    },
    "freq": {
      "ndigits": 2,
      "spaceBeforeUnit": "default",
    },
    "constants": [],
  },
  "general": {
    "thread": true,
    "processingTimeout": 5000,
    "detectVersion": true,
    "playerName": "",
    "dsForceDrm": false,
  },
  "modules": [
    {
      "type": "title",
      "key": " ",
      "keyIcon": "",
      "fqdn": false,
      "color": {
        "user": "#FCFCFA",
        "at": "",
        "host": "#727072",
      },
    },
    {
      "type": "separator",
      "string": "-",
      "outputColor": "",
      "times": 0,
    },
    {
      "type": "os",
      "keyIcon": "",
      "keyColor": "#FF6188",
    },
    {
      "type": "shell",
      "keyIcon": "",
      "keyColor": "#FC9867",
    },
    {
      "type": "wm",
      "keyIcon": "",
      "detectPlugin": true,
      "keyColor": "#FFD866",
    },
    {
      "type": "wmtheme",
      "keyIcon": "󰓸",
      "keyColor": "#FFD866",
    },
    {
      "type": "terminal",
      "keyIcon": "",
      "keyColor": "#A9DC76",
    },
    {
      "type": "cpu",
      "keyIcon": "",
      "temp": false,
      "showPeCoreCount": false,
      "keyColor": "#78DCE8",
    },
    {
      "type": "gpu",
      "keyIcon": "󰾲",
      "driverSpecific": false,
      "detectionMethod": "pci",
      "temp": false,
      "hideType": "none",
      "percent": {
        "green": 50,
        "yellow": 80,
        "type": 0,
      },
      "keyColor": "#AB9DF2",
    },
    {
      "type": "memory",
      "keyIcon": "",
      "percent": {
        "green": 50,
        "yellow": 80,
        "type": 0,
      },
      "keyColor": "#FF6188",
    },
    {
      "type": "kernel",
      "keyColor": "#FC9867",
    },
    {
      "type": "display",
      "keyColor": "#FFD866",
    },
    {
      "type": "disk",
      "keyColor": "#A9DC76",
    },
    {
      "type": "uptime",
      "keyColor": "#78DCE8",
    },
  ],
}
