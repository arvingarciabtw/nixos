{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "surface": "#2D2A2E",
    "surfaceVariant": "#221F22",
    "outline": "#403E41",
    "onSurface": "#FCFCFA",
    "onSurfaceVariant": "#C1C0C0",
    "muted": "#939293",
    "secondary": "#727072",
    "tertiary": "#5B595C",
    "red": "#FF6188",
    "orange": "#FC9867",
    "yellow": "#FFD866",
    "green": "#A9DC76",
    "cyan": "#78DCE8",
    "purple": "#AB9DF2"
  },
  "theme": {
    "primary": "onSurfaceVariant",
    "secondary": "cyan",
    "accent": "purple",

    "error": "red",
    "warning": "yellow",
    "success": "green",
    "info": "cyan",

    "text": "onSurface",
    "textMuted": "secondary",

    "background": "surface",
    "backgroundPanel": "surfaceVariant",
    "backgroundElement": "outline",

    "border": "outline",
