    "diffHighlightRemoved": "red",
    "diffAddedBg": "surfaceVariant",
    "diffRemovedBg": "surfaceVariant",
    "diffContextBg": "surface",
    "diffLineNumber": "secondary",
    "diffAddedLineNumberBg": "surfaceVariant",
    "diffRemovedLineNumberBg": "surfaceVariant",

    "markdownText": "onSurface",
    "markdownHeading": "onSurfaceVariant",
    "markdownLink": "cyan",
    "markdownLinkText": "cyan",
    "markdownCode": "yellow",
    "markdownBlockQuote": "secondary",
    "markdownEmph": "purple",
    "markdownStrong": "onSurface",
    "markdownHorizontalRule": "outline",
    "markdownListItem": "onSurfaceVariant",
    "markdownListEnumeration": "cyan",
    "markdownImage": "cyan",
    "markdownImageText": "cyan",
    "markdownCodeBlock": "onSurface",

    "syntaxComment": "secondary",
    "syntaxKeyword": "red",
    "syntaxFunction": "green",
    "syntaxVariable": "onSurface",
    "syntaxString": "yellow",
    "syntaxNumber": "purple",
    "syntaxType": "cyan",
    "syntaxOperator": "red",
    "syntaxPunctuation": "muted"
